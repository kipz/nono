{
  "meta": {
    "name": "claude-credential-routes-smoke",
    "version": "3.0.0",
    "description": "credential_routes schema with two routes: (1) Anthropic /login (oauth_intercept, direct) and (2) example gateway (proxy_provisioned_credential, direct). The gateway route provisions the access token in the proxy parent at startup. egress_headers injects org-id and other gateway-required headers that Claude Code does not reliably forward in CONNECT mode."
  },
  "extends": "default",
  "credential_routes": [
    {
      "name": "anthropic_login",
      "upstream": "https://api.anthropic.com",
      "capture": {
        "type": "oauth_intercept",
        "token_url_match": "/v1/oauth/token",
        "refresh_url_match": "/v1/oauth/token"
      },
      "delivery": { "type": "direct" },
      "bearer": {
        "header": "authorization",
        "format": "Bearer {}"
      },
      "preflight": [
        { "type": "no_static_api_key_surfaces" }
      ]
    },
    {
      "name": "example_gateway",
      "upstream": "https://gateway.example.com",
      "capture": {
        "type": "proxy_provisioned_credential",
        "source": {
          "type": "command",
          "command": "my-tool",
          "args": ["auth", "token", "example-scope"]
        }
      },
      "delivery": { "type": "direct" },
      "bearer": {
        "header": "x-api-key",
        "format": "{}"
      },
      "egress_headers": {
        "org-id": "2",
        "source": "claude-code",
        "provider": "anthropic",
        "claude-code": "true"
      },
      "preflight": [
        { "type": "no_static_api_key_surfaces" }
      ]
    }
  ],
  "groups": {
    "include": ["claude_code_macos", "user_caches_macos", "node_runtime"],
    "exclude": ["dangerous_commands", "dangerous_commands_macos"]
  },
  "allow_launch_services": true,
  "allow_parent_of_protected": true,
  "interactive": true,
  "open_urls": {
    "allow_origins": ["https://claude.ai"],
    "allow_localhost": true
  },
  "network": {
    "allow_domain": [
      "gateway.example.com",
      "claude.ai",
      "platform.claude.com",
      "api.anthropic.com",
      "statsig.anthropic.com",
      "*.statsig.com",
      "sentry.io"
    ]
  },
  "workdir": { "access": "readwrite" },
  "filesystem": {
    "allow": ["/", "~/.cache/example"],
    "bypass_protection": ["~/Library/Keychains"]
  },
  "mediation": {
    "env": {
      "block": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "CLAUDE_CODE_OAUTH_REFRESH_TOKEN",
        "CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR",
        "ANTHROPIC_UNIX_SOCKET"
      ]
    },
    "commands": [
      {
        "name": "security",
        "intercept": [
          {
            "args_prefix": ["find-generic-password", "-s", "Claude Code-credentials"],
            "action": { "type": "respond", "exit_code": 44 }
          },
          {
            "args_prefix": ["find-generic-password", "Claude Code-credentials"],
            "action": { "type": "respond", "exit_code": 44 }
          }
        ]
      }
    ]
  }
}
